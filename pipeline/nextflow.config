params {
    input = null
    outdir = 'results'
}

process {
    executor = 'local'

    withName: FASTQC {
        cpus = 2
        memory = '2 GB'
        time = '30 min'
    }

    withName: FASTP {
        cpus = 2
        memory = '2 GB'
        time = '30 min'
    }

    withName: BWAMEM2_ALIGN {
        cpus = 2
        memory = '2 GB'
        time = '30 min'
    }

    withName: SAMTOOLS_SORT {
        cpus = 2
        memory = '2 GB'
        time = '30 min'
    }

    withName: SAMTOOLS_INDEX {
        cpus = 2
        memory = '1 GB'
        time = '15 min'
    }
}

docker {
    enabled = true
    runOptions = '--platform linux/amd64'
}

profiles {
    test {
        params.input = 'test_data/samplesheet.csv'
        params.outdir = 'results/test'
    }
}